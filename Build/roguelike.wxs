<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="roguelikeGame"
           Manufacturer="UniEdu"
           Version="1.0.0.0"
           Language="1046"
           UpgradeCode="b9afb6c5-9dcc-4a54-9dde-36a3f64261eb"
           InstallerVersion="500"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="Uma versão mais recente já está instalada." />
    <MediaTemplate />

    <Icon Id="AppIcon" SourceFile="roguelike.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <StandardDirectory Id="ProgramFilesFolder">
      <Directory Id="INSTALLFOLDER" Name="MeuApp">
        <Component Id="AppComponent" Guid="*">
          <File Id="AppExe" Source="a.exe" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Menu Iniciar -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="MeuApp">
        <Component Id="MenuShortcut" Guid="*">
          <Shortcut Id="StartMenuShortcut"
                    Name="Roguelike Game"
                    Description="Meu jogo roguelike"
                    Target="[INSTALLFOLDER]a.exe"
                    Icon="AppIcon"
                    WorkingDirectory="INSTALLFOLDER" />
          <RemoveFolder Id="RemoveShortcutFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\UniEdu\roguelikeGame" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="MeuApp" Level="1">
      <ComponentRef Id="AppComponent" />
      <ComponentRef Id="MenuShortcut" />
    </Feature>

    <!-- UI para escolher pasta -->
    <!-- <UI>
      <UIRef Id="WixUI_InstallDir" />
    </UI> -->

    <!-- <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" /> -->

  </Package>
</Wix>
